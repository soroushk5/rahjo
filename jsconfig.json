{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true
  },
  "include": ["src/**/*.js", "tests/**/*.mjs"],
  "exclude": ["node_modules"]
}
