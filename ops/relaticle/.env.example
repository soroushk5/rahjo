# Copy to an untracked .env only on the target backend host.
APP_KEY=base64:GENERATE_WITH_A_SECURE_LARAVEL_KEY
APP_URL=https://crm.example.invalid
# Keep path mode: CRM UI /app, REST /api/v1, MCP /mcp. A dedicated panel
# domain activates Relaticle TrustHosts and must not be enabled casually.
APP_PANEL_DOMAIN=
APP_TIMEZONE=Asia/Tehran
REQUIRE_EMAIL_VERIFICATION=true

DB_DATABASE=relaticle
DB_USERNAME=relaticle
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# The migrator uses the database owner only during migrations/provisioning.
# The BFF uses a separate non-owner/NOBYPASSRLS role with no Relaticle-table grants.
RAHJO_MIGRATION_DATABASE_URL=postgresql://relaticle:REPLACE_WITH_DB_OWNER_SECRET@postgres:5432/relaticle
RAHJO_DATABASE_URL=postgresql://rahjo_app:REPLACE_WITH_A_SEPARATE_RUNTIME_SECRET@postgres:5432/relaticle
RAHJO_DB_RUNTIME_PASSWORD=REPLACE_WITH_A_SEPARATE_RUNTIME_SECRET
RAHJO_PUBLIC_ORIGIN=https://api.example.invalid
RAHJO_CORS_ORIGINS=https://rahjo.example.invalid
RAHJO_TOKEN_PEPPER=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET
RAHJO_API_PORT=8787
RAHJO_SESSION_HOURS=12

# One-shot provisioning only. Supply through the host secret runner, remove it
# immediately after provisioning, and never put the real value in this file.
RAHJO_PROVISION_PASSWORD=REPLACE_ONLY_DURING_ONE_SHOT_PROVISIONING

# Mounted secret file. It maps server-side Rahjo workspace IDs to team-pinned
# Relaticle PATs. Never expose these tokens to the browser or commit the file.
RELATICLE_TOKEN_FILE=/run/secrets/relaticle_workspace_tokens.json
RELATICLE_TOKEN_FILE_HOST=./secrets/relaticle_workspace_tokens.json

# Exact browser origins only. Wildcards are intentionally unsupported.
MCP_ALLOWED_ORIGINS=https://rahjo.example.invalid
