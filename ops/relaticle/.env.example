# Copy to an untracked .env only on the target backend host.
APP_KEY=base64:GENERATE_WITH_A_SECURE_LARAVEL_KEY
APP_URL=https://crm.example.invalid
APP_PANEL_DOMAIN=crm.example.invalid
APP_TIMEZONE=Asia/Tehran
REQUIRE_EMAIL_VERIFICATION=true

DB_DATABASE=relaticle
DB_USERNAME=relaticle
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

RAHJO_DATABASE_URL=postgresql://relaticle:REPLACE_WITH_A_LONG_RANDOM_SECRET@postgres:5432/relaticle
RAHJO_PUBLIC_ORIGIN=https://api.example.invalid
RAHJO_CORS_ORIGINS=https://rahjo.example.invalid
RAHJO_TOKEN_PEPPER=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET
RAHJO_API_PORT=8787

# Mounted secret file. It maps server-side Rahjo workspace IDs to team-pinned
# Relaticle PATs. Never expose these tokens to the browser or commit the file.
RELATICLE_TOKEN_FILE=/run/secrets/relaticle_workspace_tokens.json
